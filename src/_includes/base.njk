<script>
(function(){
  document.addEventListener("click", function(ev) {
    if (!window.posthog || typeof window.posthog.capture !== "function") return;
    var link = ev.target && ev.target.closest ? ev.target.closest("a") : null;
    if (!link || !link.href) return;
    var href = link.href;
    if (link.matches("[data-partner], .cta, .cta-secondary, .tbl-cta-btn, a[rel*='sponsored']")) {
      var partner = link.getAttribute("data-partner") || "Partner";
      var ctaSlot = link.getAttribute("data-cta-slot") || "inline_cta";
      var routeSlug = link.getAttribute("data-route-slug") || window.location.pathname;
      var calcInputs = link.getAttribute("data-calc-inputs") || "{}";
      var clickref = link.getAttribute("data-clickref") || "default";
      var payload = {
        partner: partner,
        cta_slot: ctaSlot,
        route_slug: routeSlug,
        calc_inputs: calcInputs,
        clickref: clickref,
        page_path: window.location.pathname,
        href: href
      };
      window.posthog.capture("cta_click", payload);
      window.posthog.capture("affiliate_cta_clicked", payload);
    } else if (href.indexOf(".gov") !== -1) {
      window.posthog.capture("gov_citation_clicked", {
        gov_url: href,
        link_text: (link.textContent || "").trim(),
        page_path: window.location.pathname
      });
    }
  });
})();
</script>
