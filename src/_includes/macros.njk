<script>
(function(){
  var box = document.getElementById("saas-seat-calc");
  if (!box) return;
  var routeSlug = box.getAttribute("data-route-slug") || "hub-payroll";
  var w2El = document.getElementById("ptc-w2");
  var w2Range = document.getElementById("ptc-w2-range");
  var stEl = document.getElementById("ptc-state");
  var stCountEl = document.getElementById("ptc-states-count");
  var c1099El = document.getElementById("ptc-1099");
  var eorEl = document.getElementById("ptc-eor");
  var yrEndEl = document.getElementById("ptc-yearend");

  function fmt(n) { return "$" + Math.round(n).toLocaleString("en-US"); }

  function compute(fromUser) {
    var w2 = Math.max(1, Math.min(250, parseInt(w2El.value || "18", 10)));
    var states = Math.max(1, Math.min(50, parseInt(stCountEl.value || "3", 10)));
    var c1099 = Math.max(0, Math.min(100, parseInt(c1099El.value || "4", 10)));
    var eor = Math.max(0, Math.min(25, parseInt(eorEl.value || "1", 10)));
    var incYearEnd = Boolean(yrEndEl && yrEndEl.checked);
    var extraStates = Math.max(0, states - 1);

    document.getElementById("ptc-w2-lbl").textContent = String(w2);
    document.getElementById("ptc-states-lbl").textContent = String(states);
    document.getElementById("ptc-1099-lbl").textContent = String(c1099);

    var opt = stEl.options[stEl.selectedIndex];
    var stateCode = opt ? opt.value : "CA";
    var suiPerEmp = opt ? parseFloat(opt.getAttribute("data-sui") || "245") : 245;
    var wageBase = opt ? parseFloat(opt.getAttribute("data-base") || "7000") : 7000;
    var agency = opt ? opt.getAttribute("data-agency") : "State DOL";

    // EOR annual cost (seat + FX spread on $80k avg EOR salary)
    var eorSeatAnnual = eor * 599 * 12;
    var deelFxAnnual = eor * 80000 * 0.0125;
    var stdFxAnnual = eor * 80000 * 0.02;

    // 1. OnPay: $40 base + $6*(w2 + c1099), $0 multi-state fee, + EOR
    var onpayYr = (49 + 6 * (w2 + c1099)) * 12 + eorSeatAnnual + stdFxAnnual;
    // 2. Gusto: $49 base + $6*(w2 + c1099) + $12/mo per extra state + EOR
    var gustoYr = (49 + 6 * (w2 + c1099) + 12 * extraStates) * 12 + eorSeatAnnual + stdFxAnnual;
    // 3. Rippling: $85 base + $16*w2 + $8*c1099 + $20/mo per extra state + (incYearEnd ? $150*extraStates state reg : 0) + EOR
    var ripplingYr = (85 + 16 * w2 + 8 * c1099 + 20 * extraStates) * 12 + (incYearEnd ? 150 * extraStates : 0) + eorSeatAnnual + stdFxAnnual;
    // 4. Deel: $19*w2 + $49*c1099 + $599*eor + deelFxAnnual
    var deelYr = (19 * w2 + 49 * c1099) * 12 + eorSeatAnnual + deelFxAnnual;
    // 5. ADP RUN: $79 base + $8*w2 + $7*c1099 + $32*extraStates + year-end W-2/1099 ($65 + $7.50*(w2+c1099)) + $175*extraStates reg + EOR
    var adpYearEnd = incYearEnd ? (65 + 7.5 * (w2 + c1099) + 175 * extraStates) : 0;
    var adpYr = (79 + 8 * w2 + 7 * c1099 + 32 * extraStates) * 12 + adpYearEnd + (eor * 699 * 12) + stdFxAnnual;

    document.getElementById("ptc-onpay-yr").textContent = fmt(onpayYr) + "/yr";
    document.getElementById("ptc-gusto-yr").textContent = fmt(gustoYr) + "/yr";
    document.getElementById("ptc-rippling-yr").textContent = fmt(ripplingYr) + "/yr";
    document.getElementById("ptc-deel-yr").textContent = fmt(deelYr) + "/yr";
    document.getElementById("ptc-adp-yr").textContent = fmt(adpYr) + "/yr";

    var saveVsAdp = Math.max(0, adpYr - Math.min(onpayYr, gustoYr));
    document.getElementById("ptc-savings-callout").textContent = "Saves " + fmt(saveVsAdp) + "/yr switching from ADP RUN";

    var totalStatutoryTax = w2 * (42 + suiPerEmp);
    document.getElementById("ptc-gov-tax-headline").textContent =
      "🏛️ 2026 Statutory Employer Tax Baseline (" + stateCode + " SUI + IRS FUTA): " + fmt(totalStatutoryTax) + "/yr";
    document.getElementById("ptc-gov-tax-detail").textContent =
      "For " + w2 + " W-2 employees in " + stateCode + " (" + agency + "): $" + suiPerEmp + "/emp SUI ($" + wageBase.toLocaleString("en-US") + " wage base) + $42/emp IRS FUTA (excludes 7.65% FICA).";

    var calcStateJson = JSON.stringify({w2: w2, state: stateCode, states: states, c1099: c1099, eor: eor, gustoYr: Math.round(gustoYr), onpayYr: Math.round(onpayYr), deelYr: Math.round(deelYr)});
    ["ptc-cta-onpay", "ptc-cta-gusto", "ptc-cta-rippling", "ptc-cta-deel"].forEach(function(id){
      var el = document.getElementById(id);
      if (el) el.setAttribute("data-calc-inputs", calcStateJson);
    });

    if (fromUser && window.posthog && typeof window.posthog.capture === "function") {
      window.posthog.capture("estimator_interaction", {
        calculator: "payroll_tco_calc",
        route_slug: routeSlug,
        w2_headcount: w2,
        primary_state: stateCode,
        state_count: states,
        contractors_1099: c1099,
        eor_headcount: eor,
        gusto_annual_tco: Math.round(gustoYr),
        onpay_annual_tco: Math.round(onpayYr)
      });
    }
  }

  if (w2Range && w2El) {
    w2Range.addEventListener("input", function(){ w2El.value = w2Range.value; compute(true); });
    w2El.addEventListener("input", function(){ w2Range.value = w2El.value; compute(true); });
  }
  [stEl, stCountEl, c1099El, eorEl, yrEndEl].forEach(function(el){
    if (el) el.addEventListener("change", function(){ compute(true); });
    if (el && el.tagName === "INPUT") el.addEventListener("input", function(){ compute(true); });
  });

  var expBtn = document.getElementById("ptc-export-btn");
  if (expBtn) {
    expBtn.addEventListener("click", function(){
      var used = parseInt(localStorage.getItem("b2b_free_exports_used") || "0", 10) + 1;
      localStorage.setItem("b2b_free_exports_used", String(used));
      var rem = Math.max(0, 3 - used);
      var cntEl = document.getElementById("ptc-export-counter");
      if (cntEl) {
        cntEl.textContent = rem > 0
          ? "CFO CSV downloaded! (" + rem + " of 3 free exports remaining before $29/mo Pro)."
          : "Free 3-export limit reached — Upgrade to SaaS Cost Audit Pro ($29/mo or $9 7-day pass) for unlimited white-label CFO exports.";
      }
      if (window.posthog && typeof window.posthog.capture === "function") {
        window.posthog.capture("export_cfo_report_clicked", {calculator: "payroll_tco_calc", route_slug: routeSlug, exports_used: used});
      }
      var csv = "Vendor,12_Month_Software_And_EOR_TCO\nOnPay," + document.getElementById("ptc-onpay-yr").textContent + "\nGusto," + document.getElementById("ptc-gusto-yr").textContent + "\nRippling," + document.getElementById("ptc-rippling-yr").textContent + "\nDeel," + document.getElementById("ptc-deel-yr").textContent + "\nADP_RUN," + document.getElementById("ptc-adp-yr").textContent + "\n";
      var blob = new Blob([csv], {type: "text/csv"});
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "saascostaudit-hris-pepm-tco-" + routeSlug + ".csv";
      a.click();
    });
  }
  box.querySelectorAll(".ssc-preset-btn").forEach(function(btn){
    btn.addEventListener("click", function(){
      if (w2El) w2El.value = btn.getAttribute("data-w2") || "25";
      if (w2Range && w2El) w2Range.value = w2El.value;
      if (stEl && btn.getAttribute("data-state")) stEl.value = btn.getAttribute("data-state");
      if (stCountEl) stCountEl.value = btn.getAttribute("data-states") || "3";
      if (c1099El) c1099El.value = btn.getAttribute("data-1099") || "4";
      if (eorEl) eorEl.value = btn.getAttribute("data-eor") || "0";
      compute(true);
    });
  });
  compute(false);
})();
</script>
{% endmacro %}



