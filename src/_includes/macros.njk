{% macro breadcrumbs(site, items) %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for i in items %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ i[0] | json | safe }},"item":"{{ site.url }}{{ i[1] }}"}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list">{% for i in items %}<li>{% if not loop.last %}<a href="{{ i[1] }}">{{ i[0] }}</a> <span aria-hidden="true">›</span> {% else %}<span aria-current="page">{{ i[0] }}</span>{% endif %}</li>{% endfor %}</ol></nav>
{% endmacro %}

{% macro verifiedGovBadge(e, pageType) %}
{% set verifyDate = (e and (e.lastVerified or e.updated)) or "2026-10-28" %}
{% set govSourceTitle = "Official FCC USF Quarterly Contribution Factor (37.6%), FCC E911 (Ray Baum's Act & Kari's Law), SEC 10-K/10-Q SaaS Filings & GSA Schedule 70 (.gov)" %}
{% set govSourceId = 1 %}
{% if e and e.sources and e.sources.length %}
  {% set foundGov = false %}
  {% for s in e.sources %}
    {% if not foundGov and (".gov" in s.url) %}
      {% set govSourceTitle = s.title %}
      {% set govSourceId = s.id %}
      {% set foundGov = true %}
    {% endif %}
  {% endfor %}
{% endif %}
<div class="verified-gov-bar" data-verified-gov-badge="true" role="region" aria-label="Statutory .gov Telecom & Public SaaS Regulatory Verification Status">
  <span class="verified-gov-badge" data-verified-gov-badge="true">✓ Verified 2026 .gov Statutory Benchmark (FCC Q4 USF 37.6% Safe-Harbor · FCC E911 Ray Baum's Act &amp; Kari's Law · SEC 10-K/10-Q · Microsoft NCE / GSA Schedule 70) · {{ verifyDate }}</span>
  {% if e and e.sources and e.sources.length %}
    <a class="gov-seal-pill" href="#src-{{ govSourceId }}" title="Jump to primary official .gov citation">🏛️ {{ govSourceTitle | truncate(64, true, "…") }}</a>
  {% else %}
    <span class="gov-seal-pill">🏛️ FCC USF (37.6%) · FCC E911 · SEC EDGAR 10-K/10-Q · GSA Schedule 70 (.gov)</span>
  {% endif %}
</div>
{% endmacro %}

{% macro verdictCard(e, site, pageType) %}
{% if e %}
{% set vSlug = e.slug or "hub" %}
{% set p1Name = e.primaryPartner or ("Gusto" if e.type == "payroll" else "Helcim") %}
{% set p2Name = e.secondaryPartner or ("Deel" if e.type == "payroll" else "Stax") %}
{% set p1Key = p1Name | lower | replace(" ", "-") %}
{% set p2Key = p2Name | lower | replace(" ", "-") %}
{% set ref1 = "b2b-verdict_card-" + vSlug + "-" + p1Key %}
{% set ref2 = "b2b-verdict_card-" + vSlug + "-" + p2Key %}
{% set url1Base = e.primaryPartnerUrl or site.primaryPayrollUrl %}
{% set url2Base = e.secondaryPartnerUrl or site.secondaryPayrollUrl %}
{% set url1 = url1Base + ("&" if "?" in url1Base else "?") + "clickref=" + ref1 %}
{% set url2 = url2Base + ("&" if "?" in url2Base else "?") + "clickref=" + ref2 %}
{% set defaultInputs = (e.calcDefaults | json) if e.calcDefaults else '{"mode":"default"}' %}
<section class="verdict-card" aria-label="30-Second TCO Audit Verdict">
  <div class="verdict-header">
    <strong>⏱️ 30-Second CFO Audit Verdict: {{ e.title }}</strong>
    <span class="verdict-pill">Deterministic 2026 Line-Item Math</span>
  </div>
  <ul class="verdict-list">
    <li class="verdict-item">
      <span class="verdict-tag tag-winner">🏆 12-MONTH TCO WINNER</span>
      <div>{{ (e.verdict and e.verdict.winner) or e.summary }}</div>
    </li>
    <li class="verdict-item">
      <span class="verdict-tag tag-trap">⚠️ HIDDEN FEE TRAP</span>
      <div>{{ (e.verdict and e.verdict.hiddenFeeTrap) or "Legacy contracts bundle multi-state tax registration fees ($150/state), W-2 year-end filing fees ($7.50/form), and +0.8% invoicing surcharges." }}</div>
    </li>
    <li class="verdict-item">
      <span class="verdict-tag tag-action">⚡ RECOMMENDED SWITCH</span>
      <div>{{ (e.verdict and e.verdict.actionLine) or "Verify your exact headcount or monthly volume in the calculator below and lock in published 2026 partner rates." }}</div>
    </li>
  </ul>
  <div class="verdict-actions">
    <a class="cta verdict-btn" data-partner="{{ p1Name }}" data-cta-slot="verdict_card" data-funnel-role="top_of_page" data-4axis-key="impact:verdict_top_{{ vSlug }}:SAAS_COSTS.ucaas_seats:top_of_page" data-route-slug="{{ vSlug }}" data-calc-inputs="{{ defaultInputs | escape }}" data-clickref="{{ ref1 }}" href="{{ url1 }}" target="_blank" rel="sponsored nofollow noopener">Compare {{ p1Name }} 2026 Rates &amp; Savings →</a>
    <a class="cta-secondary verdict-btn" data-partner="{{ p2Name }}" data-cta-slot="verdict_card" data-funnel-role="top_of_page" data-4axis-key="impact:verdict_top_{{ vSlug }}:SAAS_COSTS.ucaas_seats:top_of_page" data-route-slug="{{ vSlug }}" data-calc-inputs="{{ defaultInputs | escape }}" data-clickref="{{ ref2 }}" href="{{ url2 }}" target="_blank" rel="sponsored nofollow noopener">Audit {{ p2Name }} Custom TCO Quote →</a>
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro prices(list, site, slug, pageType, calcDefaults) %}
{% if list and list.length %}
{% set safeSlug = slug or "hub" %}
{% set defaultInputs = (calcDefaults | json) if calcDefaults else '{"mode":"table"}' %}
<h2 id="cost-comparison">2026 Line-Item TCO Comparison &amp; Partner Verification Table</h2>
<div class="table-wrap">
  <table class="price-action-table">
    <thead>
      <tr>
        <th class="sticky-col">Vendor / Statutory Benchmark</th>
        <th>Verified 2026 All-In Rate &amp; 12-Month TCO</th>
        <th>Audit Action / Official Citation</th>
      </tr>
    </thead>
    <tbody>
    {% for p in list %}
      {% set partnerName = p.partner or "Partner" %}
      {% set partnerKey = partnerName | lower | replace(" ", "-") | replace("/", "-") %}
      {% set rowClickref = "b2b-price_table_row-" + safeSlug + "-" + partnerKey + "-r" + loop.index %}
      {% set baseHref = p.ctaUrl or site.primaryPayrollUrl %}
      {% set trackedHref = baseHref + ("&" if "?" in baseHref else "?") + "clickref=" + rowClickref %}
      <tr>
        <td class="sticky-col">
          <strong>{{ p.label }}</strong>
          {% if p.ctaType == "payroll" %}<br><span class="badge-payroll">Verified 2026 Payroll/HRIS Tier</span>{% elif p.ctaType == "merchant" %}<br><span class="badge-merchant">Verified 2026 Payment Processor</span>{% else %}<br><span class="verified-gov-badge" style="font-size:.7rem;padding:.1rem .45rem">Official .gov Statutory Baseline</span>{% endif %}
        </td>
        <td><strong>{{ p.price }}</strong></td>
        <td>
          {% if p.ctaType == "gov" %}
            <a class="tbl-gov-link" href="#src-{{ p.source or 1 }}">🏛️ Verify .gov Rule [{{ p.source or 1 }}]</a>
          {% else %}
            <a class="tbl-cta-btn" data-partner="{{ partnerName }}" data-cta-slot="price_table_row" data-funnel-role="mid_content" data-4axis-key="cj:table_mid_{{ safeSlug or rSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ safeSlug }}" data-calc-inputs="{{ defaultInputs | escape }}" data-clickref="{{ rowClickref }}" href="{{ trackedHref }}" target="_blank" rel="sponsored nofollow noopener">{{ p.ctaLabel or ("Verify " + partnerName + " Rate →") }}</a>
            {% if p.source %}<small style="margin-left:.35rem"><a href="#src-{{ p.source }}">[{{ p.source }}]</a></small>{% endif %}
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
<p><small>All vendor base fees, PEPM tiers, and interchange markups verified as of October 28, 2026. Statutory SUI/FUTA/FICA and Federal Reserve Reg II debit benchmarks cite official <code>.gov</code> publications. Commercial links carry Sub-ID attribution via CJ (<code>8108003</code>), AWIN (<code>3133124</code>), and Rakuten (<code>4767884</code>) (<a href="/methodology/#affiliate-disclosure">methodology &amp; disclosure</a>).</small></p>
{% endif %}
{% endmacro %}

