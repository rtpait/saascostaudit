<script>
(function(){
  var box = document.getElementById("ucaas-tco-calculator");
  if (!box) return;
  var routeSlug = box.getAttribute("data-route-slug") || "ucaas-hub";
  var seatsEl = document.getElementById("ucc-seats");
  var seatsRange = document.getElementById("ucc-seats-range");
  var cadEl = document.getElementById("ucc-cadence");
  var pstnEl = document.getElementById("ucc-pstn");
  var aiEl = document.getElementById("ucc-ai");
  var storEl = document.getElementById("ucc-storage");
  var webEl = document.getElementById("ucc-webinars");
  var exEl = document.getElementById("ucc-existing");

  function fmt(n) { return "$" + Math.round(n).toLocaleString("en-US"); }

  function compute(fromUser) {
    var seats = Math.max(5, Math.min(1000, parseInt(seatsEl.value || "25", 10)));
    var isMonthly = cadEl.value === "monthly";
    var pstn = pstnEl.value;
    var ai = aiEl.value;
    var stor = storEl.value;
    var webinars = Math.max(0, Math.min(5, parseInt(webEl.value || "0", 10)));
    var existing = exEl.value;

    document.getElementById("ucc-seats-lbl").textContent = String(seats);
    document.getElementById("ucc-webinars-lbl").textContent = String(webinars);

    // 1. Cisco Webex Calculation
    var webexBaseSeat = 12.00;
    var webexPlanName = "Cisco Webex Meet (AI Included)";
    var webexTax = 0;
    if (pstn === "none") {
      webexBaseSeat = isMonthly ? 14.50 : 12.00;
      webexPlanName = "Cisco Webex Meet (AI + 10 GB Included)";
    } else if (pstn === "metered") {
      webexBaseSeat = isMonthly ? 20.00 : 17.00;
      webexTax = 4.50;
      webexPlanName = "Cisco Webex Calling Professional";
    } else {
      webexBaseSeat = isMonthly ? 25.00 : 22.50;
      webexTax = 4.50;
      webexPlanName = "Cisco Webex Suite (Meet + Call + AI)";
    }
    if (existing === "webex_ea") {
      webexBaseSeat = +(webexBaseSeat * 0.85).toFixed(2);
      webexPlanName += " (-15% EA)";
    }
    var webexStorMo = stor === "250gb" ? 25 : (stor === "1tb" ? 85 : 0);
    var webexWebMo = webinars * 55;
    var webexSeatAllIn = webexBaseSeat + webexTax + ((webexStorMo + webexWebMo) / seats);
    var webexYr = (seats * (webexBaseSeat + webexTax) + webexStorMo + webexWebMo) * 12;

    // 2. Microsoft Teams Calculation
    var teamsBaseSeat = isMonthly ? 4.80 : 4.00;
    var teamsPlanName = "Microsoft Teams Essentials";
    if (stor !== "10gb" || ai === "copilot") {
      teamsBaseSeat = isMonthly ? 7.20 : 6.00;
      teamsPlanName = "M365 Business Basic (1 TB + Teams)";
    }
    if (existing === "m365_basic_std" || existing === "m365_e5") {
      teamsBaseSeat = 0.00;
      teamsPlanName = existing === "m365_e5" ? "Existing M365 E5 ($0 Base + PBX)" : "Existing M365 ($0 Base Teams)";
    }
    var teamsPstnSeat = 0;
    var teamsTax = 0;
    if (pstn === "metered") {
      teamsPstnSeat = existing === "m365_e5" ? 0.00 : (isMonthly ? 9.60 : 8.00);
      teamsTax = 4.50;
    } else if (pstn === "unlimited") {
      teamsPstnSeat = existing === "m365_e5" ? (isMonthly ? 14.40 : 12.00) : (isMonthly ? 18.00 : 15.00);
      teamsTax = 4.50;
    }
    var teamsAiSeat = 0;
    if (ai === "recap") {
      teamsAiSeat = isMonthly ? 12.00 : 10.00;
    } else if (ai === "copilot") {
      teamsAiSeat = 30.00;
    }
    var teamsWebMo = (ai === "recap" || ai === "copilot") ? 0 : (webinars * 10);
    var teamsSeatAllIn = teamsBaseSeat + teamsPstnSeat + teamsAiSeat + teamsTax + (teamsWebMo / seats);
    var teamsYr = (seats * (teamsBaseSeat + teamsPstnSeat + teamsAiSeat + teamsTax) + teamsWebMo) * 12;

    // 3. Zoom Workplace Calculation
    var zoomBaseSeat = 13.33;
    var zoomPlanName = "Zoom Workplace Pro (AI Included)";
    var zoomPstnSeat = 0;
    var zoomTax = 0;
    if (pstn === "none") {
      if (seats >= 100) {
        zoomBaseSeat = isMonthly ? 21.99 : 18.32;
        zoomPlanName = "Zoom Workplace Business (AI Included)";
      } else {
        zoomBaseSeat = isMonthly ? 15.99 : 13.33;
      }
    } else if (pstn === "metered") {
      zoomBaseSeat = isMonthly ? 15.99 : 13.33;
      zoomPstnSeat = 10.00;
      zoomTax = 4.50;
      zoomPlanName = "Zoom Pro + Zoom Phone Metered";
    } else {
      zoomBaseSeat = isMonthly ? 26.99 : 22.49;
      zoomPstnSeat = 0.00;
      zoomTax = 4.50;
      zoomPlanName = "Zoom Workplace Business Plus (Phone + AI)";
    }
    var zoomStorMo = stor === "250gb" ? 100 : (stor === "1tb" ? 200 : 0);
    var zoomWebMo = webinars * 79;
    var zoomSeatAllIn = zoomBaseSeat + zoomPstnSeat + zoomTax + ((zoomStorMo + zoomWebMo) / seats);
    var zoomYr = (seats * (zoomBaseSeat + zoomPstnSeat + zoomTax) + zoomStorMo + zoomWebMo) * 12;

    // 4. Google Workspace Calculation
    var googleBaseSeat = isMonthly ? 16.80 : 14.00;
    var googlePlanName = "Google Workspace Business Standard";
    if (existing === "gworkspace_std") {
      googleBaseSeat = 0.00;
      googlePlanName = "Existing Workspace Standard ($0 Base Meet)";
    }
    var googlePstnSeat = 0;
    var googleTax = 0;
    if (pstn === "metered") {
      googlePstnSeat = seats <= 10 ? 10.00 : 20.00;
      googleTax = 4.00;
      googlePlanName += " + Google Voice";
    } else if (pstn === "unlimited") {
      googlePstnSeat = 20.00;
      googleTax = 4.00;
      googlePlanName += " + Voice Standard ($20)";
    }
    var googleWebMo = webinars * 8;
    var googleSeatAllIn = googleBaseSeat + googlePstnSeat + googleTax + (googleWebMo / seats);
    var googleYr = (seats * (googleBaseSeat + googlePstnSeat + googleTax) + googleWebMo) * 12;

    // Render 4 Primary Cards
    document.getElementById("ucc-plan-webex").textContent = webexPlanName;
    document.getElementById("ucc-webex-yr").textContent = fmt(webexYr) + "/yr";
    document.getElementById("ucc-webex-sub").textContent = "$" + webexSeatAllIn.toFixed(2) + "/seat/mo all-in · $0 AI" + (webexTax > 0 ? " · Incl. $" + webexTax.toFixed(2) + " E911/USF" : "");

    document.getElementById("ucc-plan-teams").textContent = teamsPlanName + (teamsPstnSeat > 0 ? " + Phone" : "") + (teamsAiSeat > 0 ? " + AI" : "");
    document.getElementById("ucc-teams-yr").textContent = fmt(teamsYr) + "/yr";
    document.getElementById("ucc-teams-sub").textContent = "$" + teamsSeatAllIn.toFixed(2) + "/seat/mo all-in" + (teamsAiSeat > 0 ? " · Incl. +$" + teamsAiSeat + " AI" : " · $0 AI");

    document.getElementById("ucc-plan-zoom").textContent = zoomPlanName;
    document.getElementById("ucc-zoom-yr").textContent = fmt(zoomYr) + "/yr";
    document.getElementById("ucc-zoom-sub").textContent = "$" + zoomSeatAllIn.toFixed(2) + "/seat/mo all-in · $0 AI" + (zoomStorMo > 0 ? " · +$" + zoomStorMo + "/mo Storage" : "");

    document.getElementById("ucc-plan-google").textContent = googlePlanName;
    document.getElementById("ucc-google-yr").textContent = fmt(googleYr) + "/yr";
    document.getElementById("ucc-google-sub").textContent = "$" + googleSeatAllIn.toFixed(2) + "/seat/mo all-in · Gemini Included" + (googlePstnSeat > 0 ? " · +$" + googlePstnSeat + " Voice" : "");

    // Highlight best among Big 4
    var minBig4 = Math.min(webexYr, teamsYr, zoomYr, googleYr);
    [
      ["ucc-card-webex", webexYr],
      ["ucc-card-teams", teamsYr],
      ["ucc-card-zoom", zoomYr],
      ["ucc-card-google", googleYr]
    ].forEach(function(pair){
      var cEl = document.getElementById(pair[0]);
      if (!cEl) return;
      if (Math.round(pair[1]) <= Math.round(minBig4 * 1.02)) {
        cEl.classList.add("vendor-best");
      } else {
        cEl.classList.remove("vendor-best");
      }
    });

    // Strict Merit-Only Conditional VoIP Alternative Evaluation
    var dialpadSeat = (isMonthly ? 27.00 : 15.00) + (pstn !== "none" ? 4.00 : 0);
    var nextivaSeat = (isMonthly ? 25.00 : 15.00) + (pstn !== "none" ? 4.25 : 0);
    var ringcentralSeat = (isMonthly ? 30.00 : 20.00) + (pstn !== "none" ? 4.50 : 0);
    var dialpadYr = (seats * dialpadSeat + webexStorMo + webexWebMo) * 12;
    var nextivaYr = (seats * nextivaSeat + webexStorMo + webexWebMo) * 12;
    var ringcentralYr = (seats * ringcentralSeat + webexStorMo + webexWebMo) * 12;

    var voipBox = document.getElementById("ucc-merit-voip-box");
    var big4Box = document.getElementById("ucc-merit-big4-box");

    var isBundledSuite = (existing === "m365_basic_std" || existing === "m365_e5" || existing === "webex_ea" || existing === "gworkspace_std");
    var minWebexOrTeams = Math.min(webexYr, teamsYr);
    var voipQualifiesOnMerit = (pstn !== "none") && (!isBundledSuite) && (dialpadYr < minWebexOrTeams);

    if (voipQualifiesOnMerit) {
      if (voipBox) voipBox.style.display = "block";
      if (big4Box) big4Box.style.display = "none";
      document.getElementById("ucc-dialpad-yr").textContent = fmt(dialpadYr) + "/yr";
      document.getElementById("ucc-nextiva-yr").textContent = fmt(nextivaYr) + "/yr";
      document.getElementById("ucc-ringcentral-yr").textContent = fmt(ringcentralYr) + "/yr";
      var savedVsBig4 = Math.round(minWebexOrTeams - dialpadYr);
      document.getElementById("ucc-merit-voip-desc").innerHTML =
        "Because your configuration requires <strong>greenfield PSTN business calling (" + seats + " seats) without an existing M365 or Cisco EA bundle</strong>, dedicated VoIP platforms calculate strictly lower than both Cisco Webex (" + fmt(webexYr) + "/yr) and Microsoft Teams (" + fmt(teamsYr) + "/yr) — saving up to <strong>" + fmt(savedVsBig4) + "/yr</strong>:";
    } else {
      if (voipBox) voipBox.style.display = "none";
      if (big4Box) big4Box.style.display = "block";
      var winnerLabel = teamsYr <= webexYr ? ("Microsoft Teams (" + fmt(teamsYr) + "/yr)") : ("Cisco Webex (" + fmt(webexYr) + "/yr)");
      document.getElementById("ucc-merit-big4-title").textContent =
        "✓ Merit-Only Audit Verdict: " + winnerLabel + " Beats Standalone Third-Party VoIP";
      document.getElementById("ucc-merit-big4-desc").innerHTML =
        "For your configuration (" + seats + " seats, PSTN: <code>" + pstn + "</code>, Suite: <code>" + existing + "</code>), <strong>" + winnerLabel + "</strong> delivers a lower 12-month TCO than Dialpad (" + fmt(dialpadYr) + "/yr), Nextiva (" + fmt(nextivaYr) + "/yr), and RingCentral (" + fmt(ringcentralYr) + "/yr). Per our strict Merit-Only Rule, third-party VoIP callouts are suppressed.";
    }

    var statePayload = JSON.stringify({
      seats: seats,
      cadence: cadEl.value,
      pstn: pstn,
      ai: ai,
      storage: stor,
      webinars: webinars,
      existing_suite: existing,
      webex_yr: Math.round(webexYr),
      teams_yr: Math.round(teamsYr),
      zoom_yr: Math.round(zoomYr),
      google_yr: Math.round(googleYr),
      merit_voip_shown: voipQualifiesOnMerit
    });
    ["ucc-cta-webex", "ucc-cta-teams", "ucc-cta-zoom", "ucc-cta-google", "ucc-cta-dialpad", "ucc-cta-nextiva", "ucc-cta-ringcentral"].forEach(function(id){
      var el = document.getElementById(id);
      if (el) el.setAttribute("data-calc-inputs", statePayload);
    });

    if (fromUser && window.posthog && typeof window.posthog.capture === "function") {
      window.posthog.capture("estimator_interaction", {
        calculator: "ucaas_tco_calculator",
        route_slug: routeSlug,
        seats: seats,
        cadence: cadEl.value,
        pstn: pstn,
        ai: ai,
        storage: stor,
        existing_suite: existing,
        webex_yr: Math.round(webexYr),
        teams_yr: Math.round(teamsYr),
        zoom_yr: Math.round(zoomYr),
        google_yr: Math.round(googleYr),
        merit_voip_shown: voipQualifiesOnMerit
      });
    }
  }

  if (seatsRange && seatsEl) {
    seatsRange.addEventListener("input", function(){ seatsEl.value = seatsRange.value; compute(true); });
    seatsEl.addEventListener("input", function(){ seatsRange.value = seatsEl.value; compute(true); });
  }
  [cadEl, pstnEl, aiEl, storEl, webEl, exEl].forEach(function(el){
    if (el) el.addEventListener("change", function(){ compute(true); });
    if (el && el.tagName === "INPUT") el.addEventListener("input", function(){ compute(true); });
  });

  var pMeet = document.getElementById("ucc-preset-meetings");
  if (pMeet) pMeet.addEventListener("click", function(){
    seatsEl.value = 25; seatsRange.value = 25; cadEl.value = "annual"; pstnEl.value = "none"; aiEl.value = "recap"; storEl.value = "10gb"; webEl.value = 0; exEl.value = "none"; compute(true);
  });
  var pFull = document.getElementById("ucc-preset-full");
  if (pFull) pFull.addEventListener("click", function(){
    seatsEl.value = 25; seatsRange.value = 25; cadEl.value = "annual"; pstnEl.value = "unlimited"; aiEl.value = "recap"; storEl.value = "10gb"; webEl.value = 0; exEl.value = "none"; compute(true);
  });
  var pM365 = document.getElementById("ucc-preset-m365");
  if (pM365) pM365.addEventListener("click", function(){
    seatsEl.value = 25; seatsRange.value = 25; cadEl.value = "annual"; pstnEl.value = "unlimited"; aiEl.value = "none"; storEl.value = "10gb"; webEl.value = 0; exEl.value = "m365_basic_std"; compute(true);
  });
  var pCopilot = document.getElementById("ucc-preset-copilot");
  if (pCopilot) pCopilot.addEventListener("click", function(){
    seatsEl.value = 50; seatsRange.value = 50; cadEl.value = "monthly"; pstnEl.value = "unlimited"; aiEl.value = "copilot"; storEl.value = "250gb"; webEl.value = 1; exEl.value = "none"; compute(true);
  });

  var expBtn = document.getElementById("ucc-export-btn");
  if (expBtn) {
    expBtn.addEventListener("click", function(){
      var csv = "Vendor,Plan_Modeled,12_Month_All_In_TCO,Details
" +
        "Cisco_Webex,"" + document.getElementById("ucc-plan-webex").textContent + ""," + document.getElementById("ucc-webex-yr").textContent + ","" + document.getElementById("ucc-webex-sub").textContent + ""
" +
        "Microsoft_Teams,"" + document.getElementById("ucc-plan-teams").textContent + ""," + document.getElementById("ucc-teams-yr").textContent + ","" + document.getElementById("ucc-teams-sub").textContent + ""
" +
        "Zoom_Workplace,"" + document.getElementById("ucc-plan-zoom").textContent + ""," + document.getElementById("ucc-zoom-yr").textContent + ","" + document.getElementById("ucc-zoom-sub").textContent + ""
" +
        "Google_Workspace,"" + document.getElementById("ucc-plan-google").textContent + ""," + document.getElementById("ucc-google-yr").textContent + ","" + document.getElementById("ucc-google-sub").textContent + ""
";
      var blob = new Blob([csv], {type: "text/csv"});
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "b2bfeeaudit-ucaas-tco-" + routeSlug + ".csv";
      a.click();
    });
  }
  compute(false);
})();
</script>
{% endmacro %}


