        <a class="cta-secondary tbl-cta-btn" id="ptc-cta-bark" data-partner="Bark US" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="awin:awin_3133124_bark_58887_saas_calc_{{ cSlug }}:SAAS_COSTS.hris_pepm_tiers:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="saascostaudit_seat_calc_{{ cSlug }}_bark_58887" href="https://www.awin1.com/cread.php?awinmid=58887&amp;awinaffid=3133124&amp;clickref=saascostaudit_seat_calc_{{ cSlug }}_bark_58887&amp;ued=https%3A%2F%2Fwww.bark.com%2Fen%2Fus%2Fbusiness-software%2F" target="_blank" rel="sponsored nofollow noopener">Compare 3 HRIS/SaaS Quotes (Bark US) →</a>
