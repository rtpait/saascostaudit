        <a class="cta tbl-cta-btn" id="ptc-cta-gusto" data-partner="Gusto" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="direct_partner:payroll_calc_mid_{{ cSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="b2b-payroll_calc-{{ cSlug }}-gusto" href="https://gusto.com/product/pricing?utm_source=saascostaudit&amp;utm_medium=affiliate&amp;clickref=b2b-payroll_calc-{{ cSlug }}-gusto" target="_blank" rel="sponsored nofollow noopener">Verify Gusto Trial →</a>
      </div>
    </div>
    <div class="calc-vendor-card" id="ptc-card-rippling">
      <small>Rippling Core + Payroll + IT [Quote-Only · Modeled]</small>
      <strong class="calc-big" id="ptc-rippling-yr">$5,496/yr</strong>
      <span class="calc-sub" id="ptc-rippling-sub">$85 base + $16/W-2 + $20/mo per extra state</span>
      <div style="margin-top:.55rem">
        <a class="cta-secondary tbl-cta-btn" id="ptc-cta-rippling" data-partner="Rippling" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="direct_partner:payroll_calc_mid_{{ cSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="b2b-payroll_calc-{{ cSlug }}-rippling" href="https://www.rippling.com/pricing?utm_source=saascostaudit&amp;utm_medium=affiliate&amp;clickref=b2b-payroll_calc-{{ cSlug }}-rippling" target="_blank" rel="sponsored nofollow noopener">Compare Rippling →</a>
      </div>
    </div>
    <div class="calc-vendor-card" id="ptc-card-deel">
      <small>Deel US + Global EOR</small>
      <strong class="calc-big" id="ptc-deel-yr">$6,456/yr</strong>
      <span class="calc-sub" id="ptc-deel-sub">$19/US W-2 · $49 Intl 1099 · $599/mo EOR + 1.25% FX</span>
