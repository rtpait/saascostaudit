      <button type="button" class="crm-preset-btn" data-cfo-preset="crm_ent_60" data-tier="enterprise" data-core="15" data-sales="25" data-contacts="50000" data-cadence="annual" style="font-size:.78rem;padding:.28rem .6rem;border-radius:4px;border:1px solid #cbd5e1;background:#f8fafc;cursor:pointer;font-weight:600;color:#1e293b">🚀 60-Seat Enterprise Revenue Org (15 Core + 25 Sales Ent, 50k Contacts)</button>
      <button type="button" class="crm-preset-btn" data-cfo-preset="crm_zombie_reclaim_100" data-tier="enterprise" data-core="30" data-sales="40" data-contacts="100000" data-cadence="monthly" style="font-size:.78rem;padding:.28rem .6rem;border-radius:4px;border:1px solid #cbd5e1;background:#f8fafc;cursor:pointer;font-weight:600;color:#1e293b">🧹 100-Seat View-Only Seat Reclaim &amp; 100k Contact Ratchet Audit</button>
