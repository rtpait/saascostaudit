      <label for="crm-tier">HubSpot Platform Tier:</label>
      <select id="crm-tier">
        <option value="starter">Starter Customer Platform ($15/seat · 1k Contacts)</option>
        <option value="pro" selected>Professional ($800/mo Mktg Base + $45 Core / $90 Sales Seat)</option>
        <option value="enterprise">Enterprise ($3,600/mo Mktg Base + $75 Core / $150 Sales Seat)</option>
      </select>
    </div>
    <div class="calc-field">
      <label for="crm-core">Paid Core Seats (0–200): <span id="crm-core-lbl">8</span></label>
