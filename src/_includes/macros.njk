        <a class="cta-secondary tbl-cta-btn" id="ptc-cta-deel" data-partner="Deel" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="direct_partner:payroll_calc_mid_{{ cSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="b2b-payroll_calc-{{ cSlug }}-deel" href="https://www.deel.com/pricing/?utm_source=saascostaudit&amp;utm_medium=affiliate&amp;clickref=b2b-payroll_calc-{{ cSlug }}-deel" target="_blank" rel="sponsored nofollow noopener">Get Deel Global Quote →</a>
