{% macro breadcrumbs(site, items) %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for i in items %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ i[0] | json | safe }},"item":"{{ site.url }}{{ i[1] }}"}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><ol class="breadcrumb-list">{% for i in items %}<li>{% if not loop.last %}<a href="{{ i[1] }}">{{ i[0] }}</a> <span aria-hidden="true">›</span> {% else %}<span aria-current="page">{{ i[0] }}</span>{% endif %}</li>{% endfor %}</ol></nav>
{% endmacro %}

{% macro verifiedGovBadge(e, pageType) %}
{% set verifyDate = (e and (e.lastVerified or e.updated)) or "2026-10-24" %}
{% set govSourceTitle = "Official IRS Publication 15, State DOL SUI & Federal Reserve Reg II (.gov)" %}
{% set govSourceId = 1 %}
{% if e and e.sources and e.sources.length %}
  {% set foundGov = false %}
  {% for s in e.sources %}
    {% if not foundGov and (".gov" in s.url) %}
      {% set govSourceTitle = s.title %}
      {% set govSourceId = s.id %}
      {% set foundGov = true %}
    {% endif %}
  {% endfor %}
{% endif %}
<div class="verified-gov-bar" role="region" aria-label="Regulatory Verification Status">
  <span class="verified-gov-badge">✓ Verified 2026 .gov Tax &amp; Interchange Schedule · {{ verifyDate }}</span>
  {% if e and e.sources and e.sources.length %}
    <a class="gov-seal-pill" href="#src-{{ govSourceId }}" title="Jump to primary official .gov citation">🏛️ {{ govSourceTitle | truncate(64, true, "…") }}</a>
  {% else %}
    <span class="gov-seal-pill">🏛️ IRS Pub 15 · 50-State DOL SUI · Federal Reserve Reg II (.gov)</span>
  {% endif %}
</div>
{% endmacro %}

{% macro verdictCard(e, site, pageType) %}
{% if e %}
{% set vSlug = e.slug or "hub" %}
{% set p1Name = e.primaryPartner or ("Gusto" if e.type == "payroll" else "Helcim") %}
{% set p2Name = e.secondaryPartner or ("Deel" if e.type == "payroll" else "Stax") %}
{% set p1Key = p1Name | lower | replace(" ", "-") %}
{% set p2Key = p2Name | lower | replace(" ", "-") %}
{% set ref1 = "b2b-verdict_card-" + vSlug + "-" + p1Key %}
{% set ref2 = "b2b-verdict_card-" + vSlug + "-" + p2Key %}
{% set url1Base = e.primaryPartnerUrl or site.primaryPayrollUrl %}
{% set url2Base = e.secondaryPartnerUrl or site.secondaryPayrollUrl %}
{% set url1 = url1Base + ("&" if "?" in url1Base else "?") + "clickref=" + ref1 %}
{% set url2 = url2Base + ("&" if "?" in url2Base else "?") + "clickref=" + ref2 %}
{% set defaultInputs = (e.calcDefaults | json) if e.calcDefaults else '{"mode":"default"}' %}
<section class="verdict-card" aria-label="30-Second TCO Audit Verdict">
  <div class="verdict-header">
    <strong>⏱️ 30-Second CFO Audit Verdict: {{ e.title }}</strong>
    <span class="verdict-pill">Deterministic 2026 Line-Item Math</span>
  </div>
  <ul class="verdict-list">
    <li class="verdict-item">
      <span class="verdict-tag tag-winner">🏆 12-MONTH TCO WINNER</span>
      <div>{{ (e.verdict and e.verdict.winner) or e.summary }}</div>
    </li>
    <li class="verdict-item">
      <span class="verdict-tag tag-trap">⚠️ HIDDEN FEE TRAP</span>
      <div>{{ (e.verdict and e.verdict.hiddenFeeTrap) or "Legacy contracts bundle multi-state tax registration fees ($150/state), W-2 year-end filing fees ($7.50/form), and +0.8% invoicing surcharges." }}</div>
    </li>
    <li class="verdict-item">
      <span class="verdict-tag tag-action">⚡ RECOMMENDED SWITCH</span>
      <div>{{ (e.verdict and e.verdict.actionLine) or "Verify your exact headcount or monthly volume in the calculator below and lock in published 2026 partner rates." }}</div>
    </li>
  </ul>
  <div class="verdict-actions">
    <a class="cta verdict-btn" data-partner="{{ p1Name }}" data-cta-slot="verdict_card" data-funnel-role="top_of_page" data-4axis-key="impact:verdict_top_{{ vSlug }}:SAAS_COSTS.ucaas_seats:top_of_page" data-route-slug="{{ vSlug }}" data-calc-inputs="{{ defaultInputs | escape }}" data-clickref="{{ ref1 }}" href="{{ url1 }}" target="_blank" rel="sponsored nofollow noopener">Compare {{ p1Name }} 2026 Rates &amp; Savings →</a>
    <a class="cta-secondary verdict-btn" data-partner="{{ p2Name }}" data-cta-slot="verdict_card" data-funnel-role="top_of_page" data-4axis-key="impact:verdict_top_{{ vSlug }}:SAAS_COSTS.ucaas_seats:top_of_page" data-route-slug="{{ vSlug }}" data-calc-inputs="{{ defaultInputs | escape }}" data-clickref="{{ ref2 }}" href="{{ url2 }}" target="_blank" rel="sponsored nofollow noopener">Audit {{ p2Name }} Custom TCO Quote →</a>
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro prices(list, site, slug, pageType, calcDefaults) %}
{% if list and list.length %}
{% set safeSlug = slug or "hub" %}
{% set defaultInputs = (calcDefaults | json) if calcDefaults else '{"mode":"table"}' %}
<h2 id="cost-comparison">2026 Line-Item TCO Comparison &amp; Partner Verification Table</h2>
<div class="table-wrap">
  <table class="price-action-table">
    <thead>
      <tr>
        <th class="sticky-col">Vendor / Statutory Benchmark</th>
        <th>Verified 2026 All-In Rate &amp; 12-Month TCO</th>
        <th>Audit Action / Official Citation</th>
      </tr>
    </thead>
    <tbody>
    {% for p in list %}
      {% set partnerName = p.partner or "Partner" %}
      {% set partnerKey = partnerName | lower | replace(" ", "-") | replace("/", "-") %}
      {% set rowClickref = "b2b-price_table_row-" + safeSlug + "-" + partnerKey + "-r" + loop.index %}
      {% set baseHref = p.ctaUrl or site.primaryPayrollUrl %}
      {% set trackedHref = baseHref + ("&" if "?" in baseHref else "?") + "clickref=" + rowClickref %}
      <tr>
        <td class="sticky-col">
          <strong>{{ p.label }}</strong>
          {% if p.ctaType == "payroll" %}<br><span class="badge-payroll">Verified 2026 Payroll/HRIS Tier</span>{% elif p.ctaType == "merchant" %}<br><span class="badge-merchant">Verified 2026 Payment Processor</span>{% else %}<br><span class="verified-gov-badge" style="font-size:.7rem;padding:.1rem .45rem">Official .gov Statutory Baseline</span>{% endif %}
        </td>
        <td><strong>{{ p.price }}</strong></td>
        <td>
          {% if p.ctaType == "gov" %}
            <a class="tbl-gov-link" href="#src-{{ p.source or 1 }}">🏛️ Verify .gov Rule [{{ p.source or 1 }}]</a>
          {% else %}
            <a class="tbl-cta-btn" data-partner="{{ partnerName }}" data-cta-slot="price_table_row" data-funnel-role="mid_content" data-4axis-key="cj:table_mid_{{ safeSlug or rSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ safeSlug }}" data-calc-inputs="{{ defaultInputs | escape }}" data-clickref="{{ rowClickref }}" href="{{ trackedHref }}" target="_blank" rel="sponsored nofollow noopener">{{ p.ctaLabel or ("Verify " + partnerName + " Rate →") }}</a>
            {% if p.source %}<small style="margin-left:.35rem"><a href="#src-{{ p.source }}">[{{ p.source }}]</a></small>{% endif %}
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
<p><small>All vendor base fees, PEPM tiers, and interchange markups verified as of October 24, 2026. Statutory SUI/FUTA/FICA and Federal Reserve Reg II debit benchmarks cite official <code>.gov</code> publications. Commercial links carry Sub-ID attribution via CJ (<code>8108003</code>), AWIN (<code>3133124</code>), and Rakuten (<code>4767884</code>) (<a href="/methodology/#affiliate-disclosure">methodology &amp; disclosure</a>).</small></p>
{% endif %}
{% endmacro %}

{% macro payrollTcoCalc(e, site, stateSuiData) %}
{% set cSlug = (e and e.slug) or "hub-payroll" %}
{% set d = (e and e.calcDefaults) or {} %}
{% set defW2 = d.w2 or 18 %}
{% set defStates = d.states or 3 %}
{% set defPrimaryState = d.primaryState or "CA" %}
{% set defContractors = d.contractors if d.contractors is defined else 4 %}
{% set defEor = d.eor if d.eor is defined else 1 %}
<section class="tco-calc-box" id="payroll-tco-calc" data-route-slug="{{ cSlug }}" aria-label="Interactive Payroll and Multi-State HRIS TCO Calculator">
  <div>
    <span class="badge-payroll">🧮 DETERMINISTIC PAYROLL, MULTI-STATE SUI &amp; EOR TCO CALCULATOR</span>
    <h2 style="margin:.35rem 0 .2rem;border-top:0;padding-top:0">Calculate Your 12-Month All-In Payroll, Multi-State Tax &amp; EOR Cost</h2>
    <p style="margin:0;font-size:.93rem;color:#334155">Adjust W-2 headcount, primary <code>.gov</code> SUI tax state, multi-state registrations, 1099 contractors, and international EOR seats to compare true 12-month TCO:</p>
  </div>
  <div class="calc-controls-grid">
    <div class="calc-field">
      <label for="ptc-w2">US W-2 Employees (1–250): <span id="ptc-w2-lbl">{{ defW2 }}</span></label>
      <input type="number" id="ptc-w2" min="1" max="250" value="{{ defW2 }}">
      <input type="range" id="ptc-w2-range" min="1" max="250" value="{{ defW2 }}" aria-label="US W-2 Employees Slider">
    </div>
    <div class="calc-field">
      <label for="ptc-state">Primary State (.gov SUI Lookup):</label>
      <select id="ptc-state">
        {% for st in stateSuiData.states %}
          {% set sCode = st.state_code or st.code %}
          {% set sName = st.state_name or st.name %}
          {% set sBase = st.sui_taxable_wage_base_2026_usd or st.wageBaseUsd %}
          {% set sRate = st.new_employer_sui_rate_pct or st.newEmployerRatePct %}
          {% set sSui = st.annual_sui_per_employee_new_employer_usd or st.maxNewEmployerSuiPerEmpUsd %}
          {% set sAgency = st.agency_name or st.agency %}
          <option value="{{ sCode }}" data-base="{{ sBase }}" data-rate="{{ sRate }}" data-sui="{{ sSui }}" data-agency="{{ sAgency }}" {% if sCode == defPrimaryState %}selected{% endif %}>{{ sCode }} — {{ sName }} (${{ sSui }}/emp SUI on ${{ sBase }} base)</option>
        {% endfor %}
      </select>
      <small id="ptc-state-note">Official 2026 state DOL SUI + $42 IRS FUTA</small>
    </div>
    <div class="calc-field">
      <label for="ptc-states-count">Active US Tax States (1–50): <span id="ptc-states-lbl">{{ defStates }}</span></label>
      <input type="number" id="ptc-states-count" min="1" max="50" value="{{ defStates }}">
      <small>Triggers per-state filing fees on Rippling/ADP</small>
    </div>
    <div class="calc-field">
      <label for="ptc-1099">1099 Contractors (0–100): <span id="ptc-1099-lbl">{{ defContractors }}</span></label>
      <input type="number" id="ptc-1099" min="0" max="100" value="{{ defContractors }}">
      <small>$6/mo on Gusto/OnPay vs. $49/mo Intl on Deel</small>
    </div>
    <div class="calc-field">
      <label for="ptc-eor">International EOR Headcount (0–25):</label>
      <input type="number" id="ptc-eor" min="0" max="25" value="{{ defEor }}">
      <small>$599/mo EOR seat + 1.25%–3.0% FX spread</small>
    </div>
    <div class="calc-field">
      <label for="ptc-yearend" style="cursor:pointer">
        <input type="checkbox" id="ptc-yearend" checked> Include Hidden Year-End W-2/1099 Fees &amp; State Reg
      </label>
      <small>Exposes ADP RUN $65 + $7.50/form &amp; $150–$175 state reg fees</small>
    </div>
  </div>

  <div class="calc-output-grid" id="ptc-results-grid">
    <div class="calc-vendor-card vendor-best" id="ptc-card-onpay">
      <small>OnPay (Flat 50-State Tier)</small>
      <strong class="calc-big" id="ptc-onpay-yr">$2,112/yr</strong>
      <span class="calc-sub" id="ptc-onpay-sub">$40 base + $6/seat · $0 extra state or W-2 fees</span>
      <div style="margin-top:.55rem">
        <a class="cta tbl-cta-btn" id="ptc-cta-onpay" data-partner="OnPay" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="direct_partner:payroll_calc_mid_{{ cSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="b2b-payroll_calc-{{ cSlug }}-onpay" href="https://onpay.com/pricing?utm_source=saascostaudit&amp;utm_medium=affiliate&amp;clickref=b2b-payroll_calc-{{ cSlug }}-onpay" target="_blank" rel="sponsored nofollow noopener">Lock In OnPay Rate →</a>
      </div>
    </div>
    <div class="calc-vendor-card vendor-best" id="ptc-card-gusto">
      <small>Gusto Simple / Multi-State</small>
      <strong class="calc-big" id="ptc-gusto-yr">$2,652/yr</strong>
      <span class="calc-sub" id="ptc-gusto-sub">$49 base + $6/seat · $0 W-2/1099 year-end fee</span>
      <div style="margin-top:.55rem">
        <a class="cta tbl-cta-btn" id="ptc-cta-gusto" data-partner="Gusto" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="direct_partner:payroll_calc_mid_{{ cSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="b2b-payroll_calc-{{ cSlug }}-gusto" href="https://gusto.com/product/pricing?utm_source=saascostaudit&amp;utm_medium=affiliate&amp;clickref=b2b-payroll_calc-{{ cSlug }}-gusto" target="_blank" rel="sponsored nofollow noopener">Verify Gusto Trial →</a>
      </div>
    </div>
    <div class="calc-vendor-card" id="ptc-card-rippling">
      <small>Rippling Core + Payroll + IT</small>
      <strong class="calc-big" id="ptc-rippling-yr">$5,496/yr</strong>
      <span class="calc-sub" id="ptc-rippling-sub">$85 base + $16/W-2 + $20/mo per extra state</span>
      <div style="margin-top:.55rem">
        <a class="cta-secondary tbl-cta-btn" id="ptc-cta-rippling" data-partner="Rippling" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="direct_partner:payroll_calc_mid_{{ cSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="b2b-payroll_calc-{{ cSlug }}-rippling" href="https://www.rippling.com/pricing?utm_source=saascostaudit&amp;utm_medium=affiliate&amp;clickref=b2b-payroll_calc-{{ cSlug }}-rippling" target="_blank" rel="sponsored nofollow noopener">Compare Rippling →</a>
      </div>
    </div>
    <div class="calc-vendor-card" id="ptc-card-deel">
      <small>Deel US + Global EOR</small>
      <strong class="calc-big" id="ptc-deel-yr">$6,456/yr</strong>
      <span class="calc-sub" id="ptc-deel-sub">$19/US W-2 · $49 Intl 1099 · $599/mo EOR + 1.25% FX</span>
      <div style="margin-top:.55rem">
        <a class="cta-secondary tbl-cta-btn" id="ptc-cta-deel" data-partner="Deel" data-cta-slot="payroll_calc" data-funnel-role="mid_content" data-4axis-key="direct_partner:payroll_calc_mid_{{ cSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ cSlug }}" data-calc-inputs='{"w2":{{ defW2 }},"states":{{ defStates }}}' data-clickref="b2b-payroll_calc-{{ cSlug }}-deel" href="https://www.deel.com/pricing/?utm_source=saascostaudit&amp;utm_medium=affiliate&amp;clickref=b2b-payroll_calc-{{ cSlug }}-deel" target="_blank" rel="sponsored nofollow noopener">Get Deel Global Quote →</a>
      </div>
    </div>
    <div class="calc-vendor-card" id="ptc-card-adp">
      <small>ADP RUN Legacy Benchmark</small>
      <strong class="calc-big" id="ptc-adp-yr">$4,685/yr</strong>
      <span class="calc-sub" id="ptc-adp-sub">Incl. $32/extra state + $7.50/form W-2 fee</span>
      <div style="margin-top:.55rem">
        <span style="display:inline-block;font-size:.78rem;font-weight:700;color:#991b1b" id="ptc-savings-callout">Switch to Gusto/OnPay &amp; save $2,033+/yr</span>
      </div>
    </div>
  </div>

  <div class="box" style="margin:.6rem 0 0;background:#ecfdf5;border-color:#6ee7b7">
    <strong id="ptc-gov-tax-headline">🏛️ Statutory Employer Unemployment Tax Baseline (FUTA + State SUI): $5,166/yr</strong>
    <p style="margin:.2rem 0 0;font-size:.86rem;color:#065f46" id="ptc-gov-tax-detail">Based on {{ defW2 }} W-2 employees: $42/emp IRS FUTA (0.6% on $7,000) + $245/emp State SUI (plus 7.65% employer FICA on gross wages).</p>
  </div>

  <div class="cfo-export-bar">
    <div>
      <strong>📄 Need a Board-Ready CFO Payroll &amp; Multi-State SUI Audit Report (PDF + CSV)?</strong><br>
      <small id="ptc-export-counter">Includes line-item 12-month PEPM schedule, state .gov SUI table &amp; contract buyout checklist (3 free exports remaining; Pro Unlimited $29/mo).</small>
    </div>
    <button type="button" class="cta-export" id="ptc-export-btn" data-route-slug="{{ cSlug }}" data-export-type="payroll_cfo_csv">⬇ Export CFO Audit CSV / PDF ($29 Pro Preview)</button>
  </div>
</section>
<script>
(function(){
  var box = document.getElementById("payroll-tco-calc");
  if (!box) return;
  var routeSlug = box.getAttribute("data-route-slug") || "hub-payroll";
  var w2El = document.getElementById("ptc-w2");
  var w2Range = document.getElementById("ptc-w2-range");
  var stEl = document.getElementById("ptc-state");
  var stCountEl = document.getElementById("ptc-states-count");
  var c1099El = document.getElementById("ptc-1099");
  var eorEl = document.getElementById("ptc-eor");
  var yrEndEl = document.getElementById("ptc-yearend");

  function fmt(n) { return "$" + Math.round(n).toLocaleString("en-US"); }

  function compute(fromUser) {
    var w2 = Math.max(1, Math.min(250, parseInt(w2El.value || "18", 10)));
    var states = Math.max(1, Math.min(50, parseInt(stCountEl.value || "3", 10)));
    var c1099 = Math.max(0, Math.min(100, parseInt(c1099El.value || "4", 10)));
    var eor = Math.max(0, Math.min(25, parseInt(eorEl.value || "1", 10)));
    var incYearEnd = Boolean(yrEndEl && yrEndEl.checked);
    var extraStates = Math.max(0, states - 1);

    document.getElementById("ptc-w2-lbl").textContent = String(w2);
    document.getElementById("ptc-states-lbl").textContent = String(states);
    document.getElementById("ptc-1099-lbl").textContent = String(c1099);

    var opt = stEl.options[stEl.selectedIndex];
    var stateCode = opt ? opt.value : "CA";
    var suiPerEmp = opt ? parseFloat(opt.getAttribute("data-sui") || "245") : 245;
    var wageBase = opt ? parseFloat(opt.getAttribute("data-base") || "7000") : 7000;
    var agency = opt ? opt.getAttribute("data-agency") : "State DOL";

    // EOR annual cost (seat + FX spread on $80k avg EOR salary)
    var eorSeatAnnual = eor * 599 * 12;
    var deelFxAnnual = eor * 80000 * 0.0125;
    var stdFxAnnual = eor * 80000 * 0.02;

    // 1. OnPay: $40 base + $6*(w2 + c1099), $0 multi-state fee, + EOR
    var onpayYr = (40 + 6 * (w2 + c1099)) * 12 + eorSeatAnnual + stdFxAnnual;
    // 2. Gusto: $49 base + $6*(w2 + c1099) + $12/mo per extra state + EOR
    var gustoYr = (49 + 6 * (w2 + c1099) + 12 * extraStates) * 12 + eorSeatAnnual + stdFxAnnual;
    // 3. Rippling: $85 base + $16*w2 + $8*c1099 + $20/mo per extra state + (incYearEnd ? $150*extraStates state reg : 0) + EOR
    var ripplingYr = (85 + 16 * w2 + 8 * c1099 + 20 * extraStates) * 12 + (incYearEnd ? 150 * extraStates : 0) + eorSeatAnnual + stdFxAnnual;
    // 4. Deel: $19*w2 + $49*c1099 + $599*eor + deelFxAnnual
    var deelYr = (19 * w2 + 49 * c1099) * 12 + eorSeatAnnual + deelFxAnnual;
    // 5. ADP RUN: $79 base + $8*w2 + $7*c1099 + $32*extraStates + year-end W-2/1099 ($65 + $7.50*(w2+c1099)) + $175*extraStates reg + EOR
    var adpYearEnd = incYearEnd ? (65 + 7.5 * (w2 + c1099) + 175 * extraStates) : 0;
    var adpYr = (79 + 8 * w2 + 7 * c1099 + 32 * extraStates) * 12 + adpYearEnd + (eor * 699 * 12) + stdFxAnnual;

    document.getElementById("ptc-onpay-yr").textContent = fmt(onpayYr) + "/yr";
    document.getElementById("ptc-gusto-yr").textContent = fmt(gustoYr) + "/yr";
    document.getElementById("ptc-rippling-yr").textContent = fmt(ripplingYr) + "/yr";
    document.getElementById("ptc-deel-yr").textContent = fmt(deelYr) + "/yr";
    document.getElementById("ptc-adp-yr").textContent = fmt(adpYr) + "/yr";

    var saveVsAdp = Math.max(0, adpYr - Math.min(onpayYr, gustoYr));
    document.getElementById("ptc-savings-callout").textContent = "Saves " + fmt(saveVsAdp) + "/yr switching from ADP RUN";

    var totalStatutoryTax = w2 * (42 + suiPerEmp);
    document.getElementById("ptc-gov-tax-headline").textContent =
      "🏛️ 2026 Statutory Employer Tax Baseline (" + stateCode + " SUI + IRS FUTA): " + fmt(totalStatutoryTax) + "/yr";
    document.getElementById("ptc-gov-tax-detail").textContent =
      "For " + w2 + " W-2 employees in " + stateCode + " (" + agency + "): $" + suiPerEmp + "/emp SUI ($" + wageBase.toLocaleString("en-US") + " wage base) + $42/emp IRS FUTA (excludes 7.65% FICA).";

    var calcStateJson = JSON.stringify({w2: w2, state: stateCode, states: states, c1099: c1099, eor: eor, gustoYr: Math.round(gustoYr), onpayYr: Math.round(onpayYr), deelYr: Math.round(deelYr)});
    ["ptc-cta-onpay", "ptc-cta-gusto", "ptc-cta-rippling", "ptc-cta-deel"].forEach(function(id){
      var el = document.getElementById(id);
      if (el) el.setAttribute("data-calc-inputs", calcStateJson);
    });

    if (fromUser && window.posthog && typeof window.posthog.capture === "function") {
      window.posthog.capture("estimator_interaction", {
        calculator: "payroll_tco_calc",
        route_slug: routeSlug,
        w2_headcount: w2,
        primary_state: stateCode,
        state_count: states,
        contractors_1099: c1099,
        eor_headcount: eor,
        gusto_annual_tco: Math.round(gustoYr),
        onpay_annual_tco: Math.round(onpayYr)
      });
    }
  }

  if (w2Range && w2El) {
    w2Range.addEventListener("input", function(){ w2El.value = w2Range.value; compute(true); });
    w2El.addEventListener("input", function(){ w2Range.value = w2El.value; compute(true); });
  }
  [stEl, stCountEl, c1099El, eorEl, yrEndEl].forEach(function(el){
    if (el) el.addEventListener("change", function(){ compute(true); });
    if (el && el.tagName === "INPUT") el.addEventListener("input", function(){ compute(true); });
  });

  var expBtn = document.getElementById("ptc-export-btn");
  if (expBtn) {
    expBtn.addEventListener("click", function(){
      var used = parseInt(localStorage.getItem("b2b_free_exports_used") || "0", 10) + 1;
      localStorage.setItem("b2b_free_exports_used", String(used));
      var rem = Math.max(0, 3 - used);
      var cntEl = document.getElementById("ptc-export-counter");
      if (cntEl) {
        cntEl.textContent = rem > 0
          ? "CFO CSV downloaded! (" + rem + " of 3 free exports remaining before $29/mo Pro)."
          : "Free 3-export limit reached — Upgrade to SaaS Cost Audit Pro ($29/mo or $9 7-day pass) for unlimited white-label CFO exports.";
      }
      if (window.posthog && typeof window.posthog.capture === "function") {
        window.posthog.capture("export_cfo_report_clicked", {calculator: "payroll_tco_calc", route_slug: routeSlug, exports_used: used});
      }
      var csv = "Vendor,12_Month_Software_And_EOR_TCO\nOnPay," + document.getElementById("ptc-onpay-yr").textContent + "\nGusto," + document.getElementById("ptc-gusto-yr").textContent + "\nRippling," + document.getElementById("ptc-rippling-yr").textContent + "\nDeel," + document.getElementById("ptc-deel-yr").textContent + "\nADP_RUN," + document.getElementById("ptc-adp-yr").textContent + "\n";
      var blob = new Blob([csv], {type: "text/csv"});
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "b2bfeeaudit-payroll-tco-" + routeSlug + ".csv";
      a.click();
    });
  }
  compute(false);
})();
</script>
{% endmacro %}

