    <div class="calc-vendor-card vendor-best" id="ucc-card-teams">
      <small id="ucc-plan-teams">Microsoft Teams + Phone + AI Recap</small>
      <strong class="calc-big" id="ucc-teams-yr">$10,050/yr</strong>
      <span class="calc-sub" id="ucc-teams-sub">$33.50/seat/mo all-in ($4 Base + $15 Phone + $10 AI + $4.50 Tax)</span>
      <div style="margin-top:.55rem">
        <a class="cta tbl-cta-btn" id="ucc-cta-teams" data-partner="Microsoft Teams" data-cta-slot="ucaas_tco_calc" data-funnel-role="mid_content" data-4axis-key="impact:ucaas_calc_mid_{{ uSlug }}:SAAS_COSTS.ucaas_seats:mid_content" data-route-slug="{{ uSlug }}" data-calc-inputs='{"vendor":"microsoft-teams","seats":25}' data-clickref="b2bfeeaudit_ucaas_microsoft_teams_{{ uSlug }}" href="https://www.microsoft.com/en-us/microsoft-teams/compare-microsoft-teams-options?utm_source=saascostaudit.com&amp;utm_medium=affiliate&amp;utm_campaign=ucaas_2026&amp;clickref=b2bfeeaudit_ucaas_microsoft_teams_{{ uSlug }}" target="_blank" rel="sponsored nofollow noopener">Verify Microsoft Teams Rate →</a>
      </div>
    </div>

    <div class="calc-vendor-card" id="ucc-card-zoom">
      <small id="ucc-plan-zoom">Zoom Workplace Business Plus (Phone + AI)</small>
      <strong class="calc-big" id="ucc-zoom-yr">$8,097/yr</strong>
